{
  "name": "hs-card-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "dev": "bun --bun vite dev",
    "typecheck": "tsc --noEmit",
    "build": "vite build && bun run typecheck",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-api": "swagger-typescript-api generate -p swagger.yml -o src/api --name api-client.ts --no-client"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.64.0",
    "@tanstack/react-router": "^1.158.0",
    "@tanstack/react-start": "^1.158.0",
    "antd": "^6.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.1.3",
    "eslint": "^9.22.0",
    "eslint-import-resolver-typescript": "^4.3.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "nitro": "^3.0.1-alpha.2",
    "swagger-typescript-api": "^13.0.0",
    "typescript-eslint": "^8.26.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6",
    "vitest": "^3.2.4",
    "jsdom": "^26.0.0"
  }
}
